# Copy to .env and fill in real values. Never commit .env.

# --- Stacks network (indexer) ---
STACKS_NETWORK=testnet          # testnet | mainnet
STACKS_RPC_URL=https://api.testnet.hiro.so

# --- Zest Protocol contract (Milestone 1: testnet) ---
ZEST_CONTRACT_ADDRESS=
ZEST_CONTRACT_NAME=

# --- Granite Protocol contract (Milestone 3) ---
GRANITE_CONTRACT_ADDRESS=
GRANITE_CONTRACT_NAME=

# --- API (packages/api) ---
PORT=3001

# --- Bot (packages/bot) ---
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# --- Dashboard (apps/dashboard) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
